# PlantCare AI - Backend Environment Configuration

# Application
APP_NAME=PlantCare AI
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./plantcare.db

# Authentication / JWT
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=plantcare_dev_insecure_secret_key_change_in_production_32chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# AI Model Configuration
MODEL_PATH=../ml/artifacts/plantcare_mobilenetv2_model.keras
CLASS_MAPPING_PATH=../ml/artifacts/class_indices.json
CONFIDENCE_THRESHOLD=0.60

# Weather Integration (Optional OpenWeatherMap API)
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=1800

# Chatbot Integration (Optional Google Gemini or OpenAI API)
GEMINI_API_KEY=
OPENAI_API_KEY=
